# 3TRES6 Records — clean URLs
RewriteEngine On

# /crew → /crew.html   /crew/ → /crew.html
RewriteRule ^crew/?$ crew.html [R=301,L]

# /mapa → /mapa.html   /mapa/ → /mapa.html
RewriteRule ^mapa/?$ mapa.html [R=301,L]

# /api/events → api/events.php (community events API)
RewriteRule ^api/events/?$ api/events.php [L,QSA]

# /sitemap → /sitemap.html   /sitemap/ → /sitemap.html
RewriteRule ^sitemap/?$ sitemap.html [R=301,L]